{
  "视频主题": "椒麻拌面",
  "菜品": [
    {
      "菜名": "椒麻拌面",
      "食材": [
        {
          "名称": "面条",
          "用量": "未提及"
        },
        {
          "名称": "鸡蛋",
          "用量": "1个"
        },
        {
          "名称": "火腿肠",
          "用量": "未提及"
        },
        {
          "名称": "绿叶菜",
          "用量": "未提及"
        },
        {
          "名称": "辣椒碎",
          "用量": "未提及"
        },
        {
          "名称": "葱末",
          "用量": "未提及"
        },
        {
          "名称": "蒜末",
          "用量": "未提及"
        }
      ],
      "调料": [
        {
          "名称": "食用油",
          "用量": "未提及"
        },
        {
          "名称": "生抽",
          "用量": "来点"
        },
        {
          "名称": "藤椒油",
          "用量": "一圈"
        }
      ],
      "步骤": [
        {
          "序号": 1,
          "描述": "平底锅烧油煎一个鸡蛋，煎熟后盛出；用煎蛋的底油将切片的火腿肠煎香盛出备用。",
          "时长或火候": "未提及"
        },
        {
          "序号": 2,
          "描述": "碗里放入辣椒碎、葱末、蒜末，淋上烧热的食用油激发出香味，再加入来点生抽，搅拌均匀做成酱汁。",
          "时长或火候": "未提及"
        },
        {
          "序号": 3,
          "描述": "锅中水烧开，下入面条和绿叶菜一起煮熟。",
          "时长或火候": "未提及"
        },
        {
          "序号": 4,
          "描述": "将煮熟的面条和绿叶菜捞入碗中（不用过凉水，碗底可留一点点面汤），浇上调制好的酱汁，码上煎好的鸡蛋和火腿肠，淋上一圈藤椒油，拌匀即可开吃。",
          "时长或火候": "未提及"
        }
      ],
      "小贴士": [
        "面条捞出后不用过凉水，在碗里留一点点面汤，更方便将面条拌匀入味。"
      ]
    }
  ]
}